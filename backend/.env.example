# Environment Configuration Example
NODE_ENV=development
PORT=5000

# MongoDB Database URI
MONGODB_URI=mongodb://localhost:27017/pod_ecommerce

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRE=30d

# Store Client URL
FRONTEND_URL=http://localhost:5173

# Payment Gateway (Razorpay)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_key

# Print-on-Demand (POD) Provider (Qikink)
# Mode can be 'live' (Qikink production API), 'sandbox' (Qikink sandbox API), or 'mock' (local testing)
POD_MODE=live
POD_API_URL=https://api.qikink.com
POD_API_KEY=your_qikink_live_client_id
POD_API_SECRET=your_qikink_live_client_secret
POD_WEBHOOK_SECRET=your_qikink_webhook_secret

# Optional dedicated Qikink variable names (supported natively):
# QIKINK_CLIENT_ID=your_qikink_live_client_id
# QIKINK_CLIENT_SECRET=your_qikink_live_client_secret
# QIKINK_SANDBOX_SECRET=your_qikink_sandbox_secret
# QIKINK_SANDBOX_MODE=false

# Image Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (SMTP / Transactional Email Provider)
# Set EMAIL_MODE=production to dispatch live emails; in development, outgoing emails are simulated to console
EMAIL_MODE=development
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@gtclothinghub.com
FROM_NAME=GT Clothing Hub Studio
# Common SMTP ports: 587 (TLS/STARTTLS), 465 (SSL)
# Supported by SendGrid, AWS SES, Brevo, Mailgun, Postmark, or custom SMTP
