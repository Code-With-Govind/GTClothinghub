# Environment Configuration Example
# Copy this file to .env and fill in real or sandbox credentials

NODE_ENV=development
PORT=5000

# MongoDB Database URI
MONGODB_URI=mongodb://localhost:27017/pod_ecommerce

# JSON Web Token Secret
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRE=30d

# Store Client URL
FRONTEND_URL=http://localhost:5173

# Payment Gateway (Razorpay)
# Mode can be 'test' or 'live'
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_key

# Print-on-Demand (POD) Provider
# Mode can be 'mock' (local testing), 'sandbox' (Qikink sandbox API), or 'live' (Qikink production API)
POD_MODE=sandbox
POD_API_URL=https://sandbox.qikink.com/v1
POD_API_KEY=your_qikink_sandbox_key
POD_API_SECRET=your_qikink_sandbox_secret

# Image Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service
# Mode can be 'development' (console log) or 'production' (SMTP)
EMAIL_MODE=development
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@streetwearpod.com
FROM_NAME=Streetwear POD Studio
